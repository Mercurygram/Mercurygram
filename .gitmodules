	shallow = true
	ignore = all
[submodule "TMessagesProj/lib/jlatexmath"]
	path = TMessagesProj/lib/jlatexmath
	url = https://github.com/dkaraush/jlatexmath-android.git
	shallow = true
	ignore = all
[submodule "TMessagesProj/jni/tlottie"]
	path = TMessagesProj/jni/tlottie
