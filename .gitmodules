[submodule "TMessagesProj/jni/third_party/libvpx"]
	path = TMessagesProj/jni/third_party/libvpx
	url = https://github.com/webmproject/libvpx.git
	shallow = true
[submodule "TMessagesProj/jni/third_party/dav1d"]
	path = TMessagesProj/jni/third_party/dav1d
	url = https://github.com/videolan/dav1d.git
	shallow = true
[submodule "TMessagesProj/jni/third_party/ffmpeg"]
	path = TMessagesProj/jni/third_party/ffmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
	shallow = true
	ignore = all
[submodule "TMessagesProj/jni/third_party/xiph/ogg"]
	path = TMessagesProj/jni/third_party/xiph/ogg
	url = https://github.com/xiph/ogg.git
	shallow = true
	ignore = all
