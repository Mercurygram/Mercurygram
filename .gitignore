# jni/prebuild: upstream commits the static archives its build_*.sh scripts
# produce (15 per ABI) plus the ABI-dependent ffmpeg headers. F-Droid cannot
# ship binaries it did not build, so we run those same scripts over the pinned
# submodules and treat everything they write as generated.
TMessagesProj/jni/prebuild/lib/
TMessagesProj/jni/prebuild/include/
TMessagesProj/jni/prebuild/pkgconfig/
TMessagesProj/jni/prebuild/build/
# Call core wasm module as a C array, built by jni/build_wasm_core.sh.
TMessagesProj/jni/voip/ReferenceCoreEmbedded.cpp
API_KEYS
.env
# Written at the repo root by .github/actions/jni-cache-fingerprint, hashed
# into the native-cache keys by the job that generated it. Never committed.
.jni-cache-fingerprint
.jni-cache-fingerprint.tmp
